{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(pnpm *)",
      "Bash(node_modules/.bin/vitest*)",
      "Bash(node_modules/.bin/playwright*)",
      "Bash(node_modules/.bin/prettier*)",
      "Bash(node_modules/.bin/tsc*)",
      "Bash(node *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(web/**)",
      "Edit(.claude/**)"
    ],
    "deny": ["Edit(DESIGN.md)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-invariants.mjs",
            "timeout": 15,
            "statusMessage": "Checking product invariants"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; [ -x node_modules/.bin/prettier ] && node_modules/.bin/prettier --ignore-unknown --write \"$f\"; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}
