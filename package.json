{
  "name": "stapler",
  "version": "0.1.0",
  "private": true,
  "description": "Offline PDF toolkit: merge, split, compress, sign, and redact entirely in the browser. No upload, no account, no limits.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s build:ext build:web",
    "build:ext": "BUILD_TARGET=ext vite build",
    "build:ext:firefox": "BUILD_TARGET=firefox vite build",
    "build:web": "BUILD_TARGET=web vite build",
    "check": "run-s check:type check:lint check:format check:tokens check:contrast check:invariants",
    "check:type": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:bundle": "run-s build:web && node scripts/check-bundle-size.js",
    "fixtures:static": "node scripts/generate-static-fixtures.mjs",
    "assets:promo": "node scripts/generate-promo-tiles.mjs",
    "pretest": "node scripts/generate-static-fixtures.mjs",
    "pretest:e2e": "node scripts/generate-static-fixtures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa05": "node scripts/qa05-validate.mjs",
    "validate:builds": "node scripts/validate-builds.mjs",
    "verify": "run-s check test check:bundle test:e2e"
  },
  "dependencies": {
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@preact/signals": "^2.10.1",
    "@vladmandic/face-api": "1.7.15",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "jsbarcode": "^3.12.3",
    "lucide-preact": "^1.28.0",
    "marked": "^18.0.9",
    "pdf-lib": "npm:@cantoo/pdf-lib@^2.9.1",
    "pdfjs-dist": "^6.2.108",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "utif": "^3.1.0",
    "wouter-preact": "^3.10.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.5",
    "@types/jsbarcode": "^3.11.4",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/utif": "^3.0.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "ts-morph": "^28.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
