node_modules/
dist/
test-results/
playwright-report/
# Fixtures are generated deterministically by tests/e2e/fixtures.ts (QA-01 asks that
# large/easily-reconstructed fixtures be generated at test time rather than committed).
# The small static fixtures below need external encoders to build and must not regress,
# so they are committed — see tests/fixtures/README.md.
tests/fixtures/*
!tests/fixtures/README.md
!tests/fixtures/scanned_skewed.pdf
!tests/fixtures/cmyk.pdf
!tests/fixtures/jbig2.pdf
!tests/fixtures/jpx.pdf
!tests/fixtures/encrypted.pdf
!tests/fixtures/cjk.pdf
!tests/fixtures/rtl.pdf
!tests/fixtures/xfa.pdf
!tests/fixtures/cmyk-text.pdf
!tests/fixtures/tiny.jpg
!tests/fixtures/sample.png
!tests/fixtures/sample.webp
!tests/fixtures/sample.tiff
!tests/fixtures/sample.heic
!tests/fixtures/photo-rotated.heic

# Throwaway probe scripts (see eslint.config.js ignores).
.scratch/

# Agent worktrees (see eslint.config.js ignores) — transient per-session tooling
# artifacts, never part of the codebase itself.
.claude/worktrees/
